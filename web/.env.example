# Copie para .env e preencha. NUNCA versione o .env.
#
# Login e banco (Supabase). Valores PÚBLICOS (a chave anon é pública por desenho; o RLS do banco protege os dados).
# O Worker os serve em /api/config. Em produção ficam em wrangler.jsonc (vars). Vazios = o site abre sem login.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Só para testar o Worker localmente (wrangler dev) sem login. Em produção NÃO existe: sem login configurado, a API recusa tudo.
# AUTH_OPTIONAL=true

# Valores SECRETOS (sem prefixo VITE_: só o servidor lê; nunca vão para o navegador).
# Usados pelo `npm run dev` (worker/analyze.ts) e, em produção, pelo Worker da Cloudflare:
# lá a chave é um "secret" (Settings > Variables and Secrets), não fica neste arquivo.
LLM_API_KEY=
# Opcionais (padrões: NVIDIA + gpt-oss-120b):
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=openai/gpt-oss-120b

# Jev (TypeSafe): confere se a introdução sugerida não inventa nada e se serve à vaga.
# Sem a chave, a análise funciona igual, só que sem a conferência. Em produção também é um "secret".
TYPESAFE_API_KEY=
# Opcionais (padrões: https://api.typesafe.ai e jev-1.13.0):
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_MODEL=jev-1.13.0

# Créditos (cobrança no servidor). SECRETO: chave service_role (ou "secret") do Supabase. Só o Worker usa; nunca vai ao navegador.
# Em produção é um "secret" da Cloudflare (Settings > Variables and Secrets). Sem ela, a IA recusa tudo (falha fechada).
SUPABASE_SERVICE_KEY=
