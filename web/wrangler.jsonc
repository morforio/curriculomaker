{
  "name": "currimaker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LIMITER", "class_name": "Limiter" }]
  },
  "exports": {
    "Limiter": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "LLM_BASE_URL": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "LLM_MODEL": "gemini-3.1-flash-lite",
    "LLM_REASONING_EFFORT": "minimal",
    // Login (Supabase). A chave "anon" é PÚBLICA por desenho (quem protege os dados é o RLS do banco); a "service_role" e a "secret" nunca entram aqui.
    // Para voltar a abrir o site sem login, apague estas duas linhas.
    "SUPABASE_URL": "https://zxjfojugzayjzygvvnhn.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inp4amZvanVnemF5anp5Z3Z2bmhuIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEzMjc3NTMsImV4cCI6MjEwNjkwMzc1M30.wy3kLvWNVHRij_qFtowiUKqYzCC9l8OM8o7o6jejjXo",
    "RATE_PER_IP_HOUR": "20",
    "DAILY_CAP": "200"
  },
  // Logs do Worker no painel da Cloudflare (ligados pelo painel; aqui para o deploy não desligá-los).
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true }
  },
  // Exigido pelo `wrangler preview`, que a Cloudflare roda nos branches que não são a main.
  // Vazio: o preview serve o site (assets herdados), mas sem o limitador nem a chave da IA.
  "previews": {}
}
